{
  "name": "airlinkd",
  "version": "3.0.49",
  "module": "src/app.ts",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exitcrash --exec 'bun src/app.ts' start",
    "start": "bun src/app.ts",
    "start:daemon": "bun src/app.ts start",
    "start:headless": "bun src/app.ts start",
    "status": "bun src/app.ts status",
    "version": "bun src/app.ts version",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun test",
    "build": "bun run build.ts build",
    "build:dev": "bun run build.ts build:dev",
    "build:package": "bun run build.ts package",
    "build:verify": "bun run build.ts verify",
    "build:smoke": "bun run build.ts smoke",
    "build:manifest": "bun run build.ts release-manifest",
    "generate-embedded": "bun run build.ts generate-embedded",
    "generate-embedded:check": "bun run build.ts generate-embedded --check",
    "configure": "bun src/configure.ts"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "chalk": "^5.6.2",
    "dockerode": "^4.0.10",
    "long": "^5.3.2",
    "minecraft-status": "^1.1.0",
    "protobufjs": "^7.4.0",
    "ssh2": "^1.17.0",
    "tar": "^7.5.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/dockerode": "^4.0.1",
    "@types/ssh2": "^1.15.5",
    "@types/tar": "^7.0.87",
    "bun-types": "^1.3.14",
    "nodemon": "^3.1.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.3.14"
}
